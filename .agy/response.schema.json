{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reply": {
      "type": "string",
      "maxLength": 12000,
      "description": "Markdown reply to publish in GitHub."
    },
    "skip": {
      "type": "boolean",
      "description": "Set true when no comment should be published."
    }
  },
  "required": [
    "reply",
    "skip"
  ]
}
